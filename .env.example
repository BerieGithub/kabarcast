# Address the hub listens on
KABARCAST_ADDR=:8080

# HMAC secret your apps (SSAP / RBST) use to SIGN short-lived channel tokens.
# The hub only verifies signatures - it never talks to your database.
KABARCAST_CLIENT_TOKEN_SECRET=change-me-shared-with-your-apps

# Bearer secret your backends present to POST /v1/publish
KABARCAST_SERVICE_SECRET=change-me-backend-publish-secret

# Optional. When set, events fan out across every hub instance via Redis
# pub/sub. Leave empty to run a single instance with in-memory delivery.
KABARCAST_REDIS_URL=

# Per-connection outbound buffer. When it fills, the client is treated as a
# slow consumer and disconnected rather than growing memory without bound.
KABARCAST_SEND_BUFFER=256
